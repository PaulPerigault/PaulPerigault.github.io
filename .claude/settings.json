  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard-secret-files.mjs"
            ],
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard-pr-merge.mjs"
            ],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
  },
