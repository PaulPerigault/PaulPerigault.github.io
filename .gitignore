# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Lighthouse CI
/.lighthouseci/

# Astro / tests
/.astro
/playwright-report
/test-results

# CV copié au build (scripts/fetch-cv.mjs)
/public/cv-paul-perigault.pdf

# Secrets locaux : jamais versionnés (voir infra/README.md et CLAUDE.md « Security »)
infra/.secrets.env
*.env
.env*
.dev.vars
!.dev.vars.example
!.env.example

# Terraform : le state et les plans enregistrés contiennent des secrets en clair
.terraform/
*.tfstate*
*.tfplan
*.tfvars
!*.example.tfvars
crash.log

# Wrangler (dev local du Worker)
.wrangler/

# Mesures locales de npm run bench
/bench-results.json

# Claude Code : réglages locaux (plugins désactivés, règles personnelles) et worktrees
.claude/settings.local.json
.claude/worktrees/

# Rapport du contrôle de présence en ligne (npm run check:web)
/web-presence-report.md
