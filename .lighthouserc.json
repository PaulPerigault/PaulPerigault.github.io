{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/fr/", "/en/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 250000
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "minScore": 0.5
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 10240
          }
        ]
      }
    }
  }
}
