{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/fr/", "/en/", "/fr/legal/", "/en/legal/"],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.98
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 800
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 50
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 90000
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "minScore": 0.5
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 6144
          }
        ],
        "resource-summary:total:count": [
          "error",
          {
            "maxNumericValue": 12
          }
        ]
      }
    }
  }
}
