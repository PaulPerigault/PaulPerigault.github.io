{
  "name": "paul-portfolio",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/fetch-cv.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,e2e,scripts}/**/*.{ts,mjs,astro,css,json}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{src,e2e,scripts}/**/*.{ts,mjs,astro,css,json}\" \"*.{ts,mjs,json}\"",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "npm run guard && npm run lint && npm run format:check && npm run check && npm test && npm run build && npm run verify:worker",
    "prepare": "husky",
    "check:size": "node scripts/check-file-size.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "knip": "knip",
    "guard": "npm run check:secrets && npm run check:size && npm run check:layers && npm run check:design && npm run check:matrix && npm run check:docs && npm run knip",
    "check:design": "node scripts/check-design.mjs",
    "check:matrix": "node scripts/check-test-matrix.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:secrets": "secretlint \"**/*\"",
    "verify:worker": "npm --prefix worker run verify",
    "check:links": "node scripts/check-links.mjs",
    "bench": "node scripts/bench.mjs",
    "check:seo": "playwright test e2e/seo.spec.ts e2e/crawl-files.spec.ts e2e/geo-files.spec.ts e2e/sitemap.spec.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "effect": "^3.22.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@effect/language-service": "^0.87.4",
    "@effect/vitest": "^0.30.0",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "*.{ts,mjs,astro}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@effect/vitest": {
      "vitest": "$vitest"
    }
  }
}
