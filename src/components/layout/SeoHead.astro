---
// Point d'entrée unique des balises SEO du <head> : aucune page n'en écrit elle-même.
import SeoPageTags from '@/components/layout/SeoPageTags.astro';
import type { Lang } from '@/domain/lang';
import { NOINDEX, canonicalUrl } from '@/lib/seo';

/** Page indexable : canonical, hreflang, Open Graph, JSON-LD (voir SeoPageTags). */
interface PageProps {
  kind?: 'page';
  lang: Lang;
  title: string;
  description: string;
  jsonLd?: object | undefined;
  /** La page a une version Markdown servie à `<chemin>index.md` (route `[lang]/index.md.ts`). */
  markdown?: boolean | undefined;
}

/** Page technique ou d'erreur (styleguide, 404) : hors des résultats, liens suivis. */
interface NoindexProps {
  kind: 'noindex';
  title: string;
  description?: string | undefined;
}

/** Alias d'une autre page (racine → /fr/) : seule la page canonique est indexée. */
interface AliasProps {
  kind: 'alias';
  title: string;
  /** Chemin de la page canonique, avec slashs de début et de fin. */
  canonicalPath: string;
}

type Props = PageProps | NoindexProps | AliasProps;

const props = Astro.props;
---

{props.kind === 'noindex' ? (
  <>
    <title>{props.title}</title>
    {props.description && <meta name="description" content={props.description} />}
    <meta name="robots" content={NOINDEX} />
  </>
) : props.kind === 'alias' ? (
  <>
    <title>{props.title}</title>
    <link rel="canonical" href={canonicalUrl(props.canonicalPath)} />
  </>
) : (
  <SeoPageTags
    lang={props.lang}
    title={props.title}
    description={props.description}
    jsonLd={props.jsonLd}
    markdown={props.markdown}
  />
)}
