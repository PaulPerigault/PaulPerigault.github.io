---
import DescriptionList from '@/components/ui/DescriptionList.astro';
import Section from '@/components/ui/Section.astro';
import type { Lang } from '@/domain/lang';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<Section id="about" title={t('about.title')}>
  <p class="max-w-prose text-lg">{t('about.body')}</p>
  <div class="mt-8">
    <DescriptionList
      items={[{ term: t('about.location_label'), description: t('about.location') }]}
    />
  </div>
</Section>
