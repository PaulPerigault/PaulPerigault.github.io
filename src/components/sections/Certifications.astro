---
import Section from '@/components/ui/Section.astro';
import Tag from '@/components/ui/Tag.astro';
import { navIndex } from '@/config/navigation';
import type { Certification } from '@/domain/certification';
import type { Lang } from '@/domain/lang';
import { certificationsNewestFirst } from '@/lib/chronology';
import { formatYearMonth } from '@/lib/format-date';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
  items: readonly Certification[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<Section id="certifications" index={navIndex('certifications')} title={t('certifications.title')}>
  <ul>
    {certificationsNewestFirst(items).map((cert) => (
      <li class="border-line flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t py-5">
        <div>
          <p class="font-serif text-xl">{cert.name}</p>
          <p class="text-muted font-mono text-sm">{cert.issuer}</p>
        </div>
        {cert.inProgress ? (
          <Tag>{t('certifications.in_progress')}</Tag>
        ) : (
          <p class="text-muted font-mono text-sm">
            {cert.dateIssued && (
              <time datetime={cert.dateIssued}>{formatYearMonth(cert.dateIssued, lang)}</time>
            )}
            {cert.dateExpires && (
              <span>
                {' · '}
                {t('certifications.expires')}{' '}
                <time datetime={cert.dateExpires}>{formatYearMonth(cert.dateExpires, lang)}</time>
              </span>
            )}
          </p>
        )}
      </li>
    ))}
  </ul>
</Section>
