---
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Section from '@/components/ui/Section.astro';
import { SITE } from '@/config/site';
import type { Lang } from '@/domain/lang';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const newTab = t('a11y.new_tab');
const channels = [
  { label: t('contact.email_label'), href: `mailto:${SITE.email}`, text: SITE.email },
  { label: t('contact.linkedin_label'), href: SITE.linkedinUrl, text: 'paul-perigault' },
  { label: t('contact.github_label'), href: SITE.githubUrl, text: SITE.githubUser },
];
---

<Section id="contact" title={t('contact.title')}>
  <p class="max-w-prose text-lg">{t('contact.subtitle')}</p>
  <dl class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-[max-content_1fr]">
    {channels.map(({ label, href, text }) => (
      <>
        <dt class="text-muted">{label}</dt>
        <dd>
          <ExternalLink href={href} newTabLabel={newTab}>
            {text}
          </ExternalLink>
        </dd>
      </>
    ))}
  </dl>
</Section>
