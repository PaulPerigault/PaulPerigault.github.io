---
import { Image } from 'astro:assets';
import photo from '@/assets/photo.jpg';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import { SITE } from '@/config/site';
import type { Lang } from '@/domain/lang';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const newTab = t('a11y.new_tab');
---

<section aria-labelledby="hero-title" class="pt-section pb-section">
  <Container class="grid items-end gap-10 md:grid-cols-[1fr_auto]">
    <div>
      <Heading level={1} id="hero-title">
        {SITE.name}
      </Heading>
      <p class="text-accent mt-5 text-2xl font-bold tracking-tight">{t('hero.role')}</p>
      <p class="text-muted mt-1">{t('hero.school')}</p>
      <p class="mt-6 max-w-prose">{t('hero.summary')}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <ButtonLink
          href={SITE.cvPath}
          variant="primary"
          icon="download"
          download="cv-paul-perigault.pdf"
        >
          {t('hero.cta_cv')}
        </ButtonLink>
        <ButtonLink href={`mailto:${SITE.email}`}>{t('hero.cta_contact')}</ButtonLink>
        <ButtonLink href={SITE.githubUrl} newTabLabel={newTab}>
          {t('hero.cta_github')}
        </ButtonLink>
        <ButtonLink href={SITE.linkedinUrl} newTabLabel={newTab}>
          {t('hero.cta_linkedin')}
        </ButtonLink>
      </div>
    </div>
    <Image
      src={photo}
      alt={SITE.name}
      width={200}
      height={200}
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="border-line size-40 border object-cover md:size-52"
    />
  </Container>
</section>
