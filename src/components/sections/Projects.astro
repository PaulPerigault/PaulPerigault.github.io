---
import Card from '@/components/ui/Card.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import type { Lang } from '@/domain/lang';
import type { ProjectsSnapshot } from '@/domain/project';
import { formatYearMonth } from '@/lib/format-date';
import { useTranslations } from '@/lib/i18n';
import { toYearMonth, visibleTopics } from '@/lib/projects';

interface Props {
  lang: Lang;
  snapshot: ProjectsSnapshot;
}

const { lang, snapshot } = Astro.props;
const t = useTranslations(lang);
const newTab = t('a11y.new_tab');
const month = (isoDate: string) => formatYearMonth(toYearMonth(isoDate), lang);
---

<Section id="projects" title={t('projects.title')}>
  <div data-state={snapshot.projects.length > 0 ? 'ready' : 'empty'}>
    {snapshot.projects.length === 0 ? (
      <p class="text-muted">{t('projects.empty')}</p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2">
        {snapshot.projects.map((project) => (
          <Card as="li" interactive>
            <div class="flex items-baseline justify-between gap-4">
              <Heading level={3}>
                <ExternalLink href={project.html_url} newTabLabel={newTab}>
                  {project.name}
                </ExternalLink>
              </Heading>
              {project.language && <span class="text-muted text-sm">{project.language}</span>}
            </div>
            {project.description && <p class="mt-3">{project.description}</p>}
            {visibleTopics(project.topics).length > 0 && (
              <p class="text-muted mt-3 text-sm">{visibleTopics(project.topics).join(', ')}</p>
            )}
            <p class="text-muted mt-3 text-sm">
              {t('projects.updated')} {month(project.updated_at)}
              {project.homepage && (
                <span>
                  {' · '}
                  <ExternalLink href={project.homepage} newTabLabel={newTab}>
                    {t('projects.view_demo')}
                  </ExternalLink>
                </span>
              )}
            </p>
          </Card>
        ))}
      </ul>
    )}
    <p class="text-muted mt-6 text-sm">
      {t('projects.fetched_at')} {month(snapshot.fetchedAt)}
    </p>
  </div>
</Section>
