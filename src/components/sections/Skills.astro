---
import Section from '@/components/ui/Section.astro';
import type { Lang } from '@/domain/lang';
import type { SkillCategory } from '@/domain/skill';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
  categories: readonly SkillCategory[];
}

// Espace insécable avant le séparateur : une ligne ne commence jamais par « · ».
const SEPARATOR = ' · ';

const { lang, categories } = Astro.props;
const t = useTranslations(lang);
---

<Section id="skills" title={t('skills.title')}>
  <dl class="divide-line divide-y">
    {categories.map(({ category, items }) => (
      <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <dt class="font-semibold">{category}</dt>
        <dd>{items.join(SEPARATOR)}</dd>
      </div>
    ))}
  </dl>
</Section>
