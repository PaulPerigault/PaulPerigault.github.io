---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { navIndex } from '@/config/navigation';
import type { Lang } from '@/domain/lang';
import type { SkillCategory } from '@/domain/skill';
import { useTranslations } from '@/lib/i18n';

interface Props {
  lang: Lang;
  categories: readonly SkillCategory[];
}

const { lang, categories } = Astro.props;
const t = useTranslations(lang);
---

<Section id="skills" index={navIndex('skills')} title={t('skills.title')}>
  <dl>
    {categories.map(({ category, icon, items }) => (
      <div class="border-line grid gap-3 border-t py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-accent flex items-center gap-3 font-mono text-sm">
          <Icon name={icon} />
          {category}
        </dt>
        <dd>{items.join(' · ')}</dd>
      </div>
    ))}
  </dl>
</Section>
