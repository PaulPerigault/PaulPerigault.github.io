---
import Icon from './Icon.astro';
import VisuallyHidden from './VisuallyHidden.astro';
import { BUTTON_BASE, BUTTON_VARIANT, type ButtonVariant } from '@/lib/button-styles';
import type { IconName } from '@/lib/icons';
import { isExternalHref, linkAttributes } from '@/lib/links';

interface Props {
  href: string;
  variant?: ButtonVariant;
  icon?: IconName;
  newTabLabel?: string;
  /** Nom du fichier proposé au téléchargement (lien vers un fichier du même site). */
  download?: string;
  class?: string;
}

const { href, variant = 'secondary', icon, newTabLabel, download, class: className } = Astro.props;
---

<a
  href={href}
  download={download}
  {...linkAttributes(href)}
  class:list={[BUTTON_BASE, BUTTON_VARIANT[variant], className]}
>
  {icon && <Icon name={icon} />}
  <slot />
  {newTabLabel && isExternalHref(href) && <VisuallyHidden>({newTabLabel})</VisuallyHidden>}
</a>
