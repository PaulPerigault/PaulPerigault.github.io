---
interface Item {
  term: string;
  description: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<dl class="grid gap-x-8 gap-y-3 sm:grid-cols-[max-content_1fr]">
  {items.map(({ term, description }) => (
    <>
      <dt class="text-muted font-mono text-sm">{term}</dt>
      <dd>{description}</dd>
    </>
  ))}
</dl>
