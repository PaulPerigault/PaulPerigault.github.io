---
import Container from './Container.astro';
import Heading from './Heading.astro';

interface Props {
  /** Ancre de la section ; le titre reçoit `${id}-title`. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-16">
  <Container class="border-line py-section grid gap-6 border-t md:grid-cols-[13rem_1fr] md:gap-12">
    <Heading level={2} id={`${id}-title`} class="md:sticky md:top-24 md:self-start">
      {title}
    </Heading>
    <div>
      <slot />
    </div>
  </Container>
</section>
