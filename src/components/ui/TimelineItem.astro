---
import Heading from './Heading.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Période affichée, déjà formatée et localisée. */
  period: string;
  /** Début au format machine (`YYYY-MM`) pour <time datetime>. */
  dateTime?: string;
}

const { title, subtitle, period, dateTime } = Astro.props;
---

<li class="py-6 first:pt-0 last:pb-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <Heading level={3}>{title}</Heading>
    <p class="text-muted text-sm">
      <time datetime={dateTime}>{period}</time>
    </p>
  </div>
  {subtitle && <p class="text-muted mt-1">{subtitle}</p>}
  <div class="mt-3 max-w-prose">
    <slot />
  </div>
</li>
