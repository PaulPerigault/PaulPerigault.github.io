---
import Heading from './Heading.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Période affichée, déjà formatée et localisée. */
  period: string;
  /** Début au format machine (`YYYY-MM`) pour <time datetime>. */
  dateTime?: string;
}

const { title, subtitle, period, dateTime } = Astro.props;
---

<li class="relative pb-10 pl-8 last:pb-0">
  <span class="bg-accent absolute top-2 left-0 size-2 -translate-x-1/2" aria-hidden="true"></span>
  <p class="text-muted font-mono text-xs">
    <time datetime={dateTime}>{period}</time>
  </p>
  <Heading level={3} size="xl" class="mt-1">
    {title}
  </Heading>
  {subtitle && <p class="text-muted mt-1 text-sm">{subtitle}</p>}
  <div class="mt-3 max-w-prose">
    <slot />
  </div>
</li>
