---
import type { GetStaticPaths } from 'astro';
import About from '@/components/sections/About.astro';
import Certifications from '@/components/sections/Certifications.astro';
import Contact from '@/components/sections/Contact.astro';
import Experience from '@/components/sections/Experience.astro';
import Formation from '@/components/sections/Formation.astro';
import Hero from '@/components/sections/Hero.astro';
import Skills from '@/components/sections/Skills.astro';
import { LANGS, type Lang } from '@/domain/lang';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/lib/i18n';
import { loadPortfolio } from '@/services/portfolio';
import { runBuild } from '@/services/runtime';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Charge et valide tout le contenu de la langue au build (erreur typée = build rouge).
const portfolio = await runBuild(loadPortfolio(lang));
---

<BaseLayout lang={lang} title={t('seo.title')} description={t('seo.description')}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Skills lang={lang} categories={portfolio.skills} />
  <Experience lang={lang} items={portfolio.experience} />
  <Formation lang={lang} items={portfolio.formation} />
  <Certifications lang={lang} items={portfolio.certifications} />
  <Contact lang={lang} />
</BaseLayout>
