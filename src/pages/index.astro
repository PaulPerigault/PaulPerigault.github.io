---
import SeoHead from '@/components/layout/SeoHead.astro';
import { scriptHash } from '@/lib/csp';
import { ROOT_REDIRECT_SCRIPT } from '@/lib/root-redirect';

Astro.csp?.insertScriptHash(scriptHash(ROOT_REDIRECT_SCRIPT));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/fr/" />
    {/* Pas de noindex : avec le canonical, il enverrait deux signaux contraires à Google. */}
    <SeoHead kind="alias" title="Paul Perigault" canonicalPath="/fr/" />
    <script is:inline set:html={ROOT_REDIRECT_SCRIPT} />
  </head>
  <body>
    <p>
      <a href="/fr/">Français</a> · <a href="/en/">English</a>
    </p>
  </body>
</html>
